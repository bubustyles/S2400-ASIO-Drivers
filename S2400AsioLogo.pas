function LogoHeight: Integer;
begin
  Result := Sc(30);
end;

function TextGap: Integer;
begin
  Result := Sc(10);
end;

destructor TS2400AsioLogo.Destroy;
begin
  FBitmap.Free; // vor UiGdiplusStop (das Formular wird vorher freigegeben)
  inherited Destroy;
end;

procedure TS2400AsioLogo.EnsureBitmap;
var
  MS: TMemoryStream;
  Strm: IStream;
begin
  if FBitmap <> nil then
    Exit;
  MS := TMemoryStream.Create;
  MS.WriteBuffer(C_LOGO_PNG, SizeOf(C_LOGO_PNG));
  MS.Position := 0;
  Strm := TStreamAdapter.Create(MS, soOwned);
  // TGPBitmap liest den Strom vollstaendig, solange Strm lebt; Clone loest
  // das Bild vom Strom, damit der Strom hier freigegeben werden darf
  with TGPBitmap.Create(Strm) do
  try
    FBitmap := Clone(0, 0, C_LOGO_W, C_LOGO_H, PixelFormat32bppARGB);
  finally
    Free;
  end;
end;

procedure TS2400AsioLogo.Paint;
var
  G: TGPGraphics;
  H, TY: Integer;
begin
  H := LogoHeight;
  EnsureBitmap;
  G := GpBegin(Canvas.Handle);
  try
    G.SetInterpolationMode(InterpolationModeHighQualityBicubic);
    G.SetPixelOffsetMode(PixelOffsetModeHighQuality);
    G.DrawImage(FBitmap, 0, (Height - H) div 2, FLogoW, H);
  finally
    G.Free;
  end;
  UiSetFont(Canvas.Font, 8, C_UI_MUTED);
  Canvas.Brush.Style := bsClear;
  TY := (Height - 2 * Canvas.TextHeight('Ag')) div 2;
  Canvas.TextOut(FLogoW + TextGap, TY, C_NOTE1);
  Canvas.TextOut(FLogoW + TextGap, TY + Canvas.TextHeight('Ag'), C_NOTE2);
end;

function AddAsioLogo(AParent: TWinControl; X, ACenterY: Integer): TS2400AsioLogo;
var
  B: TBitmap;
  TW, H: Integer;
begin
  H := LogoHeight;
  B := TBitmap.Create;
  try
    UiSetFont(B.Canvas.Font, 8, C_UI_MUTED);
    TW := B.Canvas.TextWidth(C_NOTE2);
    if B.Canvas.TextWidth(C_NOTE1) > TW then
      TW := B.Canvas.TextWidth(C_NOTE1);
  finally
    B.Free;
  end;
  Result := TS2400AsioLogo.Create(AParent);
  Result.FLogoW := Round(C_LOGO_W * H / C_LOGO_H);
  Result.Parent := AParent;
  Result.SetBounds(X, ACenterY - H div 2, Result.FLogoW + TextGap + TW + Sc(2), H);
end;

end.
